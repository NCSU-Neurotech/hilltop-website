# Copy this file to .env and fill in real values. Never commit the real .env
# — server/.env was accidentally committed once already; don't repeat that.

# --- Database (required) ---------------------------------------------------
# Use Supabase's CONNECTION POOLER string, not the direct connection — the
# direct host (db.<project>.supabase.co:5432) is IPv6-only in many Supabase
# regions and plenty of hosts/networks (Railway included, depending on
# region) can't reach it. The pooler host looks like
# aws-0-<region>.pooler.supabase.com, usually on port 6543 (transaction mode).
#
# The `?pgbouncer=true` query param is REQUIRED when using the pooler —
# without it, Prisma's prepared-statement caching collides with PgBouncer's
# transaction-mode pooling and every second request fails with
# "prepared statement \"s0\" already exists".
DATABASE_URL="postgresql://postgres:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# --- Auth (required) --------------------------------------------------------
# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Rotate this (and force everyone to log in again) if it's ever exposed.
JWT_SECRET=

# --- CORS / cookies (required) ----------------------------------------------
# The exact origin the client is served from — no trailing slash. Must match
# exactly (protocol + domain) or the browser will reject cross-origin
# requests. In production this is your Vercel URL (or custom domain); it's
# also what makes the login cookie's SameSite=None behavior work correctly
# (see routes/auth.js — cross-domain client/server needs SameSite=None).
CLIENT_URL=http://localhost:5173

# --- Environment (required in production) -----------------------------------
# Setting this to "production" is what switches the login cookie to
# Secure + SameSite=None (needed for a cross-domain client+server split like
# Vercel + Railway) instead of the local-dev-friendly Lax/non-Secure default.
# Leave unset (or "development") for local dev.
NODE_ENV=production

# --- Server port (optional) -------------------------------------------------
# Most hosts (Railway included) inject their own PORT — only set this
# manually for local dev if 3001 conflicts with something else.
PORT=3001

# --- ElevenLabs text-to-speech (optional) -----------------------------------
# Without these, voice playback silently falls back to the browser's built-in
# Web Speech API (see client/src/hooks/useSpeech.js) — the app works fine
# either way, this just upgrades voice quality.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# --- Password reset email (optional) ----------------------------------------
# Without these, forgot-password requests log the reset link to the server
# console instead of emailing it (see server/utils/mailer.js) — the flow still
# works locally without a mail provider, it just isn't actually delivered.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# --- Local-only seed script override (optional) -----------------------------
# server/prisma/seed.js creates one demo facility for local testing. Set this
# to override its default placeholder password. The seed script refuses to
# run at all when NODE_ENV=production, so this only matters locally.
SEED_DEMO_PASSWORD=
