# Copy this file to .env and fill in real values. Never commit the real .env.

# The server's base URL — no trailing slash. In production this is your
# Railway (or wherever the server lands) URL. Every fetch() call in the
# client falls back to http://localhost:3001 when this is unset, so local
# dev works without a .env file at all.
VITE_API_URL=http://localhost:3001
